{
  "name": "webzalokal-cloudflare",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "types:worker": "wrangler types worker-configuration.d.ts --include-runtime=false --check",
    "check": "npm run lint && npm run types:worker && npm run build && wrangler deploy --dry-run --outdir .tmp/worker-bundle && node scripts/test-worker.mjs",
    "preview:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "monitor": "node scripts/monitor.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
